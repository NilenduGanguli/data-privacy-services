# Build context for the DPS image: only pyproject.toml, README.md, dps/, frontend/ (sources),
# tools/ (seed, bench, demo and reveal tools run in the image) and docker/ are used. Everything below stays out of the context (smaller, faster, and no local
# secrets or session state can end up in a layer).
.git
.venv
**/__pycache__
**/*.py[cod]
**/node_modules
frontend/dist
docs
demo
tests
# local storage states and other secret_ref folders (compose bind-mounts them; never in a layer)
docker/secrets
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov
.env
.env.*
*.pem
*.key
service-account*.json
application_default_credentials.json
data
var
.claude
.gstack
.serena
.idea
.vscode
**/.DS_Store
