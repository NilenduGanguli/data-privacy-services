# Build context for the DPS image: only pyproject.toml, README.md, dps/, frontend/ (sources),
# tools/ (seed, bench, demo and reveal tools run in the image) and docker/ are used. Everything below stays out of the context (smaller, faster, and no local
# secrets or session state can end up in a layer).
.git
.venv
**/__pycache__
**/*.py[cod]
**/node_modules
frontend/dist
docs
demo
tests
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov
.env
.env.*
*.pem
*.key
service-account*.json
application_default_credentials.json
data
var
# M5 tool outputs (flow and demo reports, console screenshots): never in a build context
reports
.claude
.gstack
.serena
.idea
.vscode
**/.DS_Store
