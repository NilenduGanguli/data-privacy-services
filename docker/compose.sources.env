# With the `sources` profile, artefacts go to MinIO instead of the local volume (contract §11).
#   docker compose --env-file docker/compose.sources.env --profile sources up -d --build
# A lane that keeps its ports and image tag in .env passes both files:
#   docker compose --env-file .env --env-file docker/compose.sources.env --profile sources up -d --build
# Local demo literals only (MinIO root user); never used outside a laptop stack.
DPS_ARTEFACT_STORE=s3
DPS_S3_ENDPOINT_URL=http://minio:9000
DPS_S3_ACCESS_KEY_ID=minioadmin
DPS_S3_SECRET_ACCESS_KEY=minioadmin
DPS_BOOTSTRAP_API_KEY=dps_local_dev_key_change_me
